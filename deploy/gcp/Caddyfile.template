{
	# Firewall only opens TCP 80/443, so don't advertise HTTP/3 (UDP).
	servers {
		protocols h1 h2
	}
}

__DOMAIN__ {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Customer-facing surface: the share-link call room (/loan/call/... for a
	# loan customer, /d/... for a company trying a demo), its static assets,
	# and the token-gated APIs it calls. Tokens are 22-char random values and
	# the API routes re-validate them (expiry/revocation/call limits) on every
	# request. The result route only answers for a call made on that very link.
	@public path /loan/call/* /d/* /_next/static/* /favicon.ico /api/loan/links/*/public /api/loan/links/*/session /api/loan/links/*/result

	# The customer page registers its call in the operator log (POST only;
	# reading or deleting calls stays behind the login).
	@publicCallLog {
		method POST
		path /api/loan/calls
	}

	handle @public {
		reverse_proxy 127.0.0.1:3000
	}

	handle @publicCallLog {
		reverse_proxy 127.0.0.1:3000
	}

	# Everything else is the operator console (dashboards, configuration,
	# call data, API keys) and requires the operator login.
	handle {
		basic_auth {
			admin __ADMIN_HASH__
		}
		reverse_proxy 127.0.0.1:3000
	}
}

# Anyone typing the bare IP lands on the HTTPS hostname.
http://__PUBLIC_IP__ {
	redir https://__DOMAIN__{uri} permanent
}
