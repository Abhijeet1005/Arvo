[Unit]
Description=Caddy reverse proxy (local network apps)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=raspi
Group=raspi
ExecStart=/opt/caddy/caddy run --config /opt/caddy/Caddyfile
Restart=always
RestartSec=5

# Caddy needs to bind :80; grant just that capability instead of running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

MemoryHigh=64M
MemoryMax=96M

[Install]
WantedBy=multi-user.target
