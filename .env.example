# --- ElevenLabs (server-side only — NEVER exposed to the browser) ---
# Get this from your ElevenLabs account (Profile -> API Keys).
# The Loan advisor can also use a key pasted in the dashboard
# (Loan advisor -> Configuration -> ElevenLabs account), which takes priority.
ELEVENLABS_API_KEY=

# The agent this dashboard manages. Created once from the dashboard;
# paste its id here (or the app stores it for you).
ELEVENLABS_AGENT_ID=

# Optional: starting voice for the Loan advisor. Its voice, model and
# everything else can be changed from the dashboard afterwards.
ELEVENLABS_VOICE_ID=

# Secret used to verify ElevenLabs tool-webhook calls (optional in local dev).
ELEVENLABS_WEBHOOK_SECRET=

# --- Demo factory (optional) ---
# Email each client their leads. A mail server address; percent-encode special
# characters in the password (with Gmail, use an app password).
# ARVO_SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# Sender shown on those emails. Defaults to the user in ARVO_SMTP_URL.
# ARVO_MAIL_FROM=Arvo <you@gmail.com>

# --- Autopilot (optional) ---
# Claude does the research, qualifying and writing.
# ANTHROPIC_API_KEY=
# The outreach mailbox, on a SEPARATE domain from your main one (with SPF,
# DKIM and DMARC set up). Emails are sent as the user in the SMTP address.
# ARVO_OUTREACH_SMTP_URL=smtps://you%40tryarvo.in:password@smtp.zoho.in:465
# The same mailbox over IMAP, so replies and bounces stop follow-ups.
# ARVO_OUTREACH_IMAP_URL=imaps://you%40tryarvo.in:password@imap.zoho.in:993
